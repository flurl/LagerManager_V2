# Database
# DB_NAME is development-only: it selects the database used by the dev stack
# (docker-compose.yml) and is managed by scripts/branch-db.sh. Unused in production.
POSTGRES_DB=lagermanager
POSTGRES_USER=lagermanager
POSTGRES_PASSWORD=change-me-strong-password

# Django
DATABASE_URL=postgres://lagermanager:change-me-strong-password@db:5432/lagermanager
DJANGO_SECRET_KEY=change-me-long-random-secret-key
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts (no scheme, no port)
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Comma-separated list of trusted origins (with scheme)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CORS — origins that may call the API (with scheme, no trailing slash)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Production stack (docker-compose.prod.yml) — optional, defaults shown.
# scripts/preview.sh sets these (and PREVIEW_*, GIT_COMMIT*) in each preview's own .env.
#HTTPS_BIND_ADDRESS=172.16.73.1
#HTTPS_PORT=443
#GUNICORN_WORKERS=4

# Email (SMTP) — only used when DJANGO_DEBUG=False; dev uses console backend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user@example.com
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
SERVER_EMAIL=noreply@yourdomain.com
# Optional Reply-To address added to outgoing document emails (invoices, offers, reminders).
# Leave unset to omit the Reply-To header entirely.
#DEFAULT_REPLY_TO_EMAIL=contact@yourdomain.com
